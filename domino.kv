#:import dp kivy.metrics.dp
#:import FitImage kivymd.uix.fitimage.FitImage

<MenuScreen>:
    name: "menu"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)
  
        MDBoxLayout:
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(15)
            size_hint_y: None
            height: dp(260)   # <-- creates space for logo + title + fact
            
            FitImage:
                source: "data/icon_1024.png"
                size_hint: None, None
                size: dp(120), dp(120)
                pos_hint: {"center_x": 0.5}

            MDLabel:
                id: title_label
                text: "Domino Scorebook"
                font_style: "H4"
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                id: fact_label
                text: ""
                halign: "center"
                theme_text_color: "Secondary"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
    
        MDRaisedButton:
            id: start_btn
            text: "Start Game"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "select"

        MDRaisedButton:
            text: "Create Player"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "create"

        MDRaisedButton:
            id: history_btn
            text: "History"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "history"
        
        MDRaisedButton:
            text: "Stats"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "stats"
        
        Widget:
        
        MDBoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(20)
            pos_hint: {"center_x": 0.5}
            size_hint_x: None
            width: dp(260)  # controls how far apart they are

            MDRaisedButton:
                text: "Options"
                size_hint_x: 1
                on_release: app.root.current = "options"
        
            MDRaisedButton:
                text: "Exit"
                size_hint_x: 1
                on_release: app.stop()
            

<PlayerSelectScreen>:
    name: "select"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        ScrollView:
            MDBoxLayout:
                id: players_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

        MDRaisedButton:
            text: "Start Game"
            on_release: root.start_game()

        MDFlatButton:
            text: "Cancel"
            on_release: root.cancel()


<GameScreen>:
    name: "game"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        ScrollView:
            MDBoxLayout:
                id: score_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height

        MDRaisedButton:
            text: "Finish Hand"
            on_release: root.finish_game()

        MDFlatButton:
            text: "Cancel Game"
            on_release: root.cancel_game()


<HistoryScreen>:
    name: "history"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        ScrollView:
            MDList:
                id: history_list

        MDFlatButton:
            text: "Back"
            on_release: root.manager.current = "menu"


<EditGameScreen>:
    name: "edit"
    
    MDBoxLayout:
        orientation: 'vertical'
        
        MDTopAppBar:
            title: "Edit Game"
            left_action_items: [["arrow-left", lambda x: root.cancel()]]

        ScrollView:
            MDBoxLayout:
                id: players_container  # <--- We will add textfields here
                orientation: 'vertical'
                adaptive_height: True
                padding: dp(20)
                spacing: dp(15)

        # Date Field and Save Button at the bottom
        MDBoxLayout:
            adaptive_height: True
            padding: dp(20)
            
            MDTextField:
                id: date_field
                hint_text: "Game Date"
                readonly: True
                
            MDIconButton:
                icon: "calendar"
                on_release: root.show_date_picker()
        
        MDRaisedButton:
            text: "Save Changes"
            pos_hint: {"center_x": .5}
            on_release: root.save_changes()


<StatsScreen>:
    name: "stats"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        MDRaisedButton:
            id: player_button
            text: "Select Player"
            on_release: root.open_menu()

        MDLabel:
            id: wins
            text: "Wins: —"

        MDLabel:
            id: losses
            text: "Losses: —"

        MDLabel:
            id: games
            text: "Games Played: —"

        MDLabel:
            id: winrate
            text: "Win Rate: —"

        MDFlatButton:
            text: "Back"
            on_release: root.manager.current = "menu"
         
<CreatePlayerScreen>:
    name: "create"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)

        MDTextField:
            id: player_name
            hint_text: "Player Name"
            multiline: False

        MDRaisedButton:
            text: "Save"
            size_hint_y: None
            height: dp(48)
            on_release: root.save_player()

        MDRaisedButton:
            text: "Back"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "menu"
        
        MDWidget:


<OptionsScreen>:
    name: "options"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)

        MDRaisedButton:
            text: "Export Saves"
            size_hint_y: None
            height: dp(48)
            on_release: root.export_saves()

        MDRaisedButton:
            text: "Import Saves"
            size_hint_y: None
            height: dp(48)
            on_release: root.import_saves()
        
        MDSeparator:

        MDRaisedButton:
            text: "Back"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "menu"
        
        MDBoxLayout:
            orientation:"vertical"
            size_hint:(1.0, 0.5)


<EditablePlayerScore>:
    MDBoxLayout:
        id:editbox
        orientation:"horizontal"
        padding:dp(20)
        spacing:dp(20)
        
        MDTextField:
            id: name_field
            hint_text:"name"
            multiline: False
        
        MDTextField:
            id: score_field
            hint_text:"score"
            multiline:False
            input_filter:"int"