#:import dp kivy.metrics.dp
#:import FitImage kivymd.uix.fitimage.FitImage
#:import MDSeparator ui_helpers.MDSeparator
#:import MDTopAppBar kivymd.uix.toolbar.MDTopAppBar
#:import MDIconButton kivymd.uix.button.MDIconButton
#:import CleanTextField ui_helpers.CleanTextField


<MyButton@MDRaisedButton>:
    size_hint_y: None
    height: dp(48)
    md_bg_color: 1,1,1,0
    
    canvas.before:
        Color:
            rgba: app.get_color()
        RoundedRectangle:
            pos: self.pos
            size: self.size
            # The radius of the corners [top-left, top-right, bottom-right, bottom-left]
            radius: [25, 25, 25, 25]



<MenuScreen>:
    name: "menu"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)
  
        MDBoxLayout:
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(15)
            size_hint_y: None
            height: dp(260)   # <-- creates space for logo + title + fact
            
            FitImage:
                
                canvas.before:
                    Color:
                        rgba: app.get_color()
                        
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [25, 25, 25, 25]
                    
                source: "data/icon_1024.png"
                size_hint: None, None
                size: dp(120), dp(120)
                pos_hint: {"center_x": 0.5}

            MDLabel:
                id: title_label
                
                canvas.after:
                    Color:
                        rgba: app.get_color()
                    
                    # The border line
                    Line:
                        width: 5
                        # (x, y, width, height, radius)
                        # Note: The radius here (25) should match the radius in canvas.before
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 25)
               
                text: "Domino Scorebook"
                font_style: "H4"
                font_size: "42sp"
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                id: fact_label
                text: root.get_fact()
                halign: "center"
                theme_text_color: "Secondary"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
    
        MyButton:
            id: start_btn
            text: "Start Game"
            on_release: app.root.current = "select"

        MyButton:
            id: stats_btn
            text: "Player Stats"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "stats"
        
        MyButton:
            id: history_btn
            text: "Game History"
            on_release: app.root.current = "history"
        
        #MyButton:
#            id: board_btn
#            text: "Board"
#            on_release: app.root.current = "board"
                
        Widget:
        
        MDLabel:
            text:"GickiStudios"
            font_size: "10sp"
            halign:"center"
            size_hint:1,None
            pos_hint: {"bottom":0}
            
                
        MDSeparator:
        
        MDBoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(20)
            pos_hint:{"center_x":0.5}
            size_hint_x: None
            width: dp(260)  # controls how far apart they are
                    
            MyButton:
                text: "Options"
                size_hint_x: 1
                on_release: app.root.current = "options"
            
            MyButton:
                text: "Exit"
                size_hint_x: 1
                on_release: app.stop()


<PlayerSelectScreen>:
    name:"select"
    
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)
        
        MDTopAppBar:
            title: "Select Players"
            left_action_items: [["arrow-left", lambda x: app.go_back()]]
            right_action_items: [["account-check", lambda x: None]]

        ScrollView:
            spacing: dp(15)
            MDBoxLayout:
                id: players_box
                
                canvas.before:
                    Color:
                        rgba: 0.2, 0.5, 0.2, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        # The radius of the corners [top-left, top-right, bottom-right, bottom-left]
                        radius: [25, 25, 25, 25] 

                adaptive_height: True
                orientation: "vertical"               
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(15)
                padding: dp(15)

        MDRaisedButton:
            id: start_btn
            text: "Start Game"
            on_release: root.start_game()
            disabled: len(root.selected) < 2
        
        MDRaisedButton:
            id: create_btn
            text: "Create Player"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "create"
        
        MDRaisedButton:
            id: delete_btn
            text: "Delete Players"
            disabled: len(root.selected) != 1
            on_release: root.delete()


<CreatePlayerScreen>:
    name: "create"
    
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            title: "Create Player"
            left_action_items: [["arrow-left", lambda x: app.go_back()]]
            right_action_items: [["account-plus", lambda x: None]]
        
        MDBoxLayout:
            orientation: "vertical"
            padding: dp(15)
            spacing: dp(15)
            size_hint_y: None
            height: self.minimum_height
            
            MDTextField:
                id: player_name
                hint_text: "King Dingle"
                size_hint_x: 0.5
                pos_hint: {"center_x":0.5}
                multiline: False
                on_text_validate: root.save()
            
            MDLabel:
                text: "Name:"
                halign: "center"
        
        MDBoxLayout:
            orientation: "vertical"
            
            MDRaisedButton:
                text: "Save"
                size_hint_y: None
                height: dp(48)
                on_release: root.save()


<GameScreen>:
    name: "game"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        # The area where player rows will be added dynamically
        ScrollView:
            MDBoxLayout:
                id: score_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(20) # Add breathing room between players
        
        # Bottom Action Bar (Static)
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(60)
            spacing: dp(10)
            
            # Primary Action: End the round
            MDRaisedButton:
                text: "END ROUND"
                size_hint_x: 0.5
                size_hint_y: 0.9
                font_style: "H6"
                md_bg_color: app.theme_cls.primary_color
                pos_hint:{"center_x":0.5, "center_y":0.5}
                on_release: root.commit_round()
            
            # Secondary Actions: Finish or Cancel
            MDBoxLayout:
                orientation: "vertical"
                size_hint_x: 0.4
                spacing: dp(15)
                padding: dp(15)

                MDRaisedButton:
                    text: "Finish Game"
                    size_hint: (0.8,0.8)
                    md_bg_color: .8, .2, .2, 1  # Reddish for caution
                    pos_hint:{"center_x":0.5}
                    on_release: root.finish_game()
        
                MDRaisedButton:
                    text: "Cancel"
                    size_hint: (0.8,0.8)
                    md_bg_color: .5, .5, .5, 1  # Gray for cancel
                    pos_hint:{"center_x":0.5}
                    on_release: root.cancel_game()


<HistoryScreen>:
    name: "history"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)
            
        MDTopAppBar:
            title: "Game History"
            left_action_items: [["arrow-left", lambda x: app.go_back()]]
            right_action_items: [["history", lambda x: None]]

        ScrollView:
            MDList:
                id: history_list



<EditGameScreen>:
    name: "edit"
    
    MDBoxLayout:
        orientation: 'vertical'
        
        MDTopAppBar:
            title: "Edit Game"
            left_action_items: [["arrow-left", lambda x: root.cancel()]]

        ScrollView:
            MDBoxLayout:
                id: players_container  # <--- We will add textfields here
                orientation: 'vertical'
                adaptive_height: True
                padding: dp(20)
                spacing: dp(15)

        # Date Field and Save Button at the bottom
        MDBoxLayout:
            adaptive_height: True
            padding: dp(20)
            
            MDTextField:
                id: date_field
                hint_text: "Game Date"
                readonly: True
                
            MDIconButton:
                icon: "calendar"
                on_release: root.show_date_picker()
        
        MDBoxLayout:
            orientation:"horizontal"
            padding:dp(15)
            spacing:dp(10)
        
            MDRaisedButton:
                text: "Save Changes"
                pos_hint: {"center_x": .5}
                on_release: root.save_changes()
            
            MDRaisedButton:
                text: "Delete Game"
                pos_hint: {"center_x": .5}
                on_release: root.delete()


<OptionsScreen>:
    name: "options"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)
    
        MDTopAppBar:
            title: "Options"
            left_action_items: [["arrow-left", lambda x: app.go_back()]]
        
        MDLabel:
            text:"Collect all the player and game data into a json format that can be copied and stored."
            halign:"center"
            size_hint_y:None
            size_hint_x: 0.7
            pos_hint: {"center_x":0.5}
            height:self.texture_size[1]
            font_size:"16sp"

        Widget:

        MDRaisedButton:
            text: "Export Data"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "export"

        MDRaisedButton:
            text: "Import Data"
            size_hint_y: None
            height: dp(48)
            on_release: app.root.current = "import"


<EditPlayerScreen>:
    name: "editplayer"
    
    MDBoxLayout:
        orientation: 'vertical'
        
        MDTopAppBar:
            title: "Edit Game"
            left_action_items: [["arrow-left", lambda x: root.cancel()]]
        
        MDLabel:
            id: player_name

        MDTextField:
            id: player_nickname
            hint_text: "nickname"


<ImportScreen>:
    name: "import"

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Paste data"
            left_action_items: [["arrow-left",lambda x: root.to_options()]]
            right_action_items: [["import", lambda x: None]]
            size_hint_y: None
            height: self.theme_cls.standard_increment

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(10)
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height

                CleanTextField:
                    id: import_field
                    multiline: True
                    size_hint_y: None
                    height: "200dp"

                MyButton:
                    text: "Import"
                    on_release: root.import_data(import_field.text)


<ExportScreen>:
    name:"export"
    
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)
        
        MDTopAppBar:
            title: "Export Data"
            left_action_items: [["arrow-left", lambda x: root.to_options()]]
            right_action_items: [["export", lambda x: None]]
            
        MDLabel:
            id:export_label
        
        MyButton:
            id: copy_button
            text: "Copy Data"
            on_release: root.copy_data()
            pos_hint: {"center_x":0.5}
            disabled: True


<DominoTileWidget>:
    size_hint: None, None
    size: dp(80), dp(160)

    canvas:
        Color:
            rgba: self.tile_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
    

<BoardScreen>:
    name: "board"

    MDBoxLayout:
        orientation: "vertical"

        RelativeLayout:
            id: board_area

        FloatLayout:
            id: hand_area
            size_hint_y: None
            height: dp(180)
            
            canvas.before:
                Color:
                    rgba: 0.1, 0.1, 0.1, 0.3
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]