from kivymd.uix.screen import MDScreen
from kivy.clock import Clock
from kivy.metrics import dp
from kivy.core.window import Window
from domino_widgets import DominoTileWidget
import models


class BoardScreen(MDScreen):

    # ======================================================
    # LIFECYCLE
    # ======================================================

    def on_enter(self, *args):
        print(">>> ENTER BoardScreen.on_enter")

        self.hand_tiles: list[models.DominoTile] = []
        self.board_tiles: list[models.DominoTile] = []

        self._setup_new_game()

        Clock.schedule_once(self.refresh_ui, 0)

        print("<<< EXIT BoardScreen.on_enter")

    # ======================================================
    # GAME SETUP
    # ======================================================

    def _setup_new_game(self):
        print(">>> ENTER BoardScreen._setup_new_game")

        all_tiles = models.DominoTile.create_double_sixes()

        self.hand_tiles = all_tiles[:7]
        self.board_tiles = []

        print("<<< EXIT BoardScreen._setup_new_game")

    # ======================================================
    # UI REFRESH
    # ======================================================

    def refresh_ui(self, *args):
        print(">>> ENTER BoardScreen.refresh_ui")

        print("HAND:", len(self.hand_tiles))
        print("BOARD:", len(self.board_tiles))
        print("Refreshing UI")

        self._refresh_hand()
        self._refresh_board()

        print("<<< EXIT BoardScreen.refresh_ui")

    # ======================================================
    # HAND AREA
    # ======================================================

    def _refresh_hand(self):
        print(">>> ENTER BoardScreen._refresh_hand")

        hand = self.ids.hand_area
        hand.clear_widgets()

        tw, th = self.tile_size()

        for model in self.hand_tiles:
            tile = DominoTileWidget(
                value_top=model.value_top,
                value_bottom=model.value_bottom,
                size_hint=(None, None),
                size=(tw, th),
            )
            tile.model = model
            hand.add_widget(tile)

        print("<<< EXIT BoardScreen._refresh_hand")

    # ======================================================
    # BOARD AREA
    # ======================================================

    def _refresh_board(self):
        print(">>> ENTER BoardScreen._refresh_board")

        board = self.ids.board_area
        board.clear_widgets()

        x, y = dp(40), dp(40)

        for model in self.board_tiles:
            tw, th = self.tile_size()

            tile = DominoTileWidget(
                value_top=model.value_top,
                value_bottom=model.value_bottom,
                size_hint=(None, None),
                size=(tw, th),
            )
            tile.model = model
            tile.pos = (x, y)
            board.add_widget(tile)

            x += dp(90)
            if x > self.width - dp(120):
                x = dp(40)
                y += dp(170)

        print("<<< EXIT BoardScreen._refresh_board")

    # ======================================================
    # TILE INTERACTION
    # ======================================================

    def play_tile(self, model: models.DominoTile):
        print(">>> ENTER BoardScreen.play_tile")

        if model not in self.hand_tiles:
            print("Model not in hand, returning")
            print("<<< EXIT BoardScreen.play_tile")
            return

        self.hand_tiles.remove(model)
        self.board_tiles.append(model)
        self.refresh_ui()

        print("<<< EXIT BoardScreen.play_tile")


    def on_tile_dropped(self, tile_widget):
        print(">>> ENTER BoardScreen.on_tile_dropped")

        model = tile_widget.model
        if not model:
            print("No model found, returning")
            print("<<< EXIT BoardScreen.on_tile_dropped")
            return

        if model in self.hand_tiles:
            self.hand_tiles.remove(model)
            self.board_tiles.append(model)

            tile_widget.parent.remove_widget(tile_widget)

            tw, th = self.tile_size()
            tile_widget.size = (tw, th)

            board = self.ids.board_area
            tile_widget.pos = (dp(40), dp(40) + len(self.board_tiles) * dp(100))
            board.add_widget(tile_widget)

        print("<<< EXIT BoardScreen.on_tile_dropped")


    def tile_size(self):
        print(">>> ENTER BoardScreen.tile_size")
    
        hand = self.ids.hand_area
    
        if not hand.width:
            return dp(40), dp(80)
    
        spacing = hand.spacing[0] if isinstance(hand.spacing, (list, tuple)) else hand.spacing
        padding_left, padding_top, padding_right, padding_bottom = hand.padding
    
        total_spacing = spacing * 6
        total_padding = padding_left + padding_right
    
        available = hand.width - total_spacing - total_padding
    
        w = available / 7
        h = w * 2
    
        print("<<< EXIT BoardScreen.tile_size")
        return w, h